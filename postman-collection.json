    "name": "Blogging Platform API",
    "description": "Complete Postman Collection for the RESTful Blog API. Follows best practices with dynamic variables and automatic authentication token saving scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
